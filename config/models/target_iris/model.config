<?xml version="1.0"?>

<model>
  <name>Target Iris (no camera)</name>
  <version>2.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Fadri Furrer</name>
    <email>fadri.furrer@mavt.ethz.ch</email>
  </author>
  <author>
    <name>Michael Burri</name>
  </author>
  <author>
    <name>Mina Kamel</name>
  </author>
  <author>
    <name>Janosch Nikolic</name>
  </author>
  <author>
    <name>Markus Achtelik</name>
  </author>

  <maintainer email="hsu@osrfoundation.org">john hsu</maintainer>

  <description>
    Target UAV for the interceptor sim. Copy of
    external/ardupilot_gazebo/models/iris_with_ardupilot with
    &lt;fdm_port_in&gt; changed to 9012 so a second SITL instance (-I1) can drive it.
    Regenerate from upstream; do not hand-edit beyond the port.
  </description>
  <depend>
    <model>
      <uri>model://iris_with_standoffs</uri>
      <version>1.0</version>
    </model>
  </depend>
</model>
